# ==============================================================================
# AI-Powered Chatbot Configuration
# ==============================================================================

# Required: API key for the LLM provider (or dummy value for local Ollama)
LLM_API_KEY=your_api_key_here

# Optional: Custom API base URL (e.g., http://localhost:11434/v1 for Ollama, https://api.groq.com/openai/v1 for Groq)
# If omitted or left empty, defaults to OpenAI's official endpoint.
LLM_BASE_URL=

# Optional: Model identifier (default: gpt-4o-mini)
LLM_MODEL=gpt-4o-mini

# Optional: Sampling temperature between 0.0 and 2.0 (default: 0.5)
LLM_TEMPERATURE=0.5

# Optional: Maximum tokens in generated completion (default: 1024)
LLM_MAX_OUTPUT_TOKENS=1024

# Optional: Maximum context window size in characters for history memory trimming (default: 24000)
MAX_CONTEXT_CHARS=24000

# Optional: Maximum allowed character length for a single user input (default: 4000)
MAX_INPUT_CHARS=4000

# Optional: Directory path for persisting conversation sessions (default: data/sessions)
SESSIONS_DIR=data/sessions
